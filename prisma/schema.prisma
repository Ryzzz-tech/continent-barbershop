generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model booking {
  id_booking            String     @id @db.VarChar(5)
  tanggal_booking       DateTime   @db.Date
  jam_booking           DateTime   @db.Time(6)
  status                String     @db.VarChar(20)
  catatan               String?    @db.VarChar(100)
  catatan_status        String?    @db.VarChar(100)
  id_pelanggan          String     @db.VarChar(5)
  id_kapster            String     @db.VarChar(5)
  id_layanan            String     @db.VarChar(5)
  id_kasir              String?    @db.VarChar(5)
  nama_layanan_snapshot String?    @db.VarChar(100)
  harga_snapshot        Decimal?   @db.Decimal(12, 2)
  durasi_snapshot       Int?
  kapster               kapster    @relation(fields: [id_kapster], references: [id_kapster], map: "fk_booking_kapster")
  kasir                 kasir?     @relation(fields: [id_kasir], references: [id_kasir], onDelete: Restrict, onUpdate: Cascade, map: "fk_booking_kasir")
  layanan               layanan    @relation(fields: [id_layanan], references: [id_layanan], map: "fk_booking_layanan")
  pelanggan             pelanggan  @relation(fields: [id_pelanggan], references: [id_pelanggan], map: "fk_booking_pelanggan")
  transaksi             transaksi?
}

model detail_restok {
  id_detail_restok  String  @id @db.VarChar(5)
  jumlah            Int
  harga_beli_satuan Decimal @db.Decimal(12, 2)
  subtotal          Decimal @db.Decimal(12, 2)
  id_produk         String  @db.VarChar(5)
  id_restok         String  @db.VarChar(5)
  produk            produk  @relation(fields: [id_produk], references: [id_produk], map: "fk_detail_restok_produk")
  restok            restok  @relation(fields: [id_restok], references: [id_restok], map: "fk_detail_restok_restok")
}

model detail_transaksi {
  id_detail          String    @id @db.VarChar(5)
  jenis_item         String    @db.VarChar(20)
  jumlah             Int
  harga_satuan       Decimal   @db.Decimal(12, 2)
  total              Decimal   @db.Decimal(12, 2)
  id_transaksi       String    @db.VarChar(5)
  id_layanan         String?   @db.VarChar(5)
  id_produk          String?   @db.VarChar(5)
  nama_item_snapshot String?   @db.VarChar(100)
  layanan            layanan?  @relation(fields: [id_layanan], references: [id_layanan], onDelete: Restrict, map: "fk_detail_transaksi_layanan")
  produk             produk?   @relation(fields: [id_produk], references: [id_produk], onDelete: Restrict, map: "fk_detail_transaksi_produk")
  transaksi          transaksi @relation(fields: [id_transaksi], references: [id_transaksi], map: "fk_detail_transaksi_transaksi")
}

model jadwal_kapster {
  id_jadwal   String   @id @db.VarChar(5)
  tanggal     DateTime @db.Date
  jam_mulai   DateTime @db.Time(6)
  jam_selesai DateTime @db.Time(6)
  status      String   @db.VarChar(20)
  id_kapster  String   @db.VarChar(5)
  id_kasir    String?  @db.VarChar(5)
  catatan     String?  @db.VarChar(100)
  kapster     kapster  @relation(fields: [id_kapster], references: [id_kapster], map: "fk_jadwal_kapster")
  kasir       kasir?   @relation(fields: [id_kasir], references: [id_kasir], onDelete: Restrict, onUpdate: Cascade, map: "fk_jadwal_kasir")
}

model kapster {
  id_kapster     String           @id @db.VarChar(5)
  nama           String           @db.VarChar(100)
  no_hp          String           @unique @db.VarChar(13)
  status         String           @db.VarChar(20)
  email          String           @unique @db.VarChar(100)
  akun           akun?
  booking        booking[]
  jadwal_kapster jadwal_kapster[]
}

model kasir {
  id_kasir       String           @id @db.VarChar(5)
  nama           String           @db.VarChar(100)
  no_hp          String           @unique @db.VarChar(13)
  email          String           @unique @db.VarChar(100)
  akun           akun?
  booking        booking[]
  jadwal_kapster jadwal_kapster[]
  transaksi      transaksi[]
}

model layanan {
  id_layanan       String             @id @db.VarChar(5)
  nama_layanan     String             @db.VarChar(100)
  durasi           Int
  harga            Decimal            @db.Decimal(12, 2)
  is_active        Boolean            @default(true)
  booking          booking[]
  detail_transaksi detail_transaksi[]
}

model owner {
  id_owner String   @id @db.VarChar(5)
  nama     String   @db.VarChar(100)
  no_hp    String   @unique @db.VarChar(13)
  email    String   @unique @db.VarChar(100)
  akun     akun?
  restok   restok[]
}

model pelanggan {
  id_pelanggan   String      @id @db.VarChar(5)
  nama           String      @db.VarChar(100)
  no_hp          String      @unique @db.VarChar(13)
  alamat         String      @db.VarChar(500)
  tanggal_daftar DateTime    @db.Date
  email          String      @unique @db.VarChar(100)
  akun           akun?
  booking        booking[]
  transaksi      transaksi[]
}

model produk {
  id_produk        String             @id @db.VarChar(5)
  nama_produk      String             @db.VarChar(100)
  harga            Decimal            @db.Decimal(12, 2)
  stok             Int
  satuan           String             @db.VarChar(20)
  detail_restok    detail_restok[]
  detail_transaksi detail_transaksi[]
}

model restok {
  id_restok      String          @id @db.VarChar(5)
  tanggal_restok DateTime        @db.Date
  keterangan     String?         @db.VarChar(200)
  id_owner       String          @db.VarChar(5)
  detail_restok  detail_restok[]
  owner          owner           @relation(fields: [id_owner], references: [id_owner], map: "fk_restok_owner")
}

model transaksi {
  id_transaksi      String             @id @db.VarChar(5)
  tanggal_transaksi DateTime           @db.Date
  total_harga       Decimal            @db.Decimal(12, 2)
  metode_pembayaran String             @db.VarChar(30)
  status_pembayaran String             @db.VarChar(20)
  id_pelanggan      String             @db.VarChar(5)
  id_kasir          String?            @db.VarChar(5)
  id_booking        String?            @unique @db.VarChar(5)
  detail_transaksi  detail_transaksi[]
  booking           booking?           @relation(fields: [id_booking], references: [id_booking], onDelete: Restrict, onUpdate: Cascade, map: "fk_transaksi_booking")
  kasir             kasir?             @relation(fields: [id_kasir], references: [id_kasir], onDelete: Restrict, onUpdate: Cascade, map: "fk_transaksi_kasir")
  pelanggan         pelanggan          @relation(fields: [id_pelanggan], references: [id_pelanggan], map: "fk_transaksi_pelanggan")
}

model akun {
  id_akun       String     @id @default(uuid()) @db.Uuid
  email         String     @unique @db.VarChar(100)
  password_hash String     @db.VarChar(255)
  role          String     @db.VarChar(20)
  is_active     Boolean    @default(true)
  session_version Int      @default(0)
  id_owner      String?    @unique @db.VarChar(5)
  id_kasir      String?    @unique @db.VarChar(5)
  id_kapster    String?    @unique @db.VarChar(5)
  id_pelanggan  String?    @unique @db.VarChar(5)
  created_at    DateTime   @default(now()) @db.Timestamp(6)
  updated_at    DateTime   @updatedAt @db.Timestamp(6)
  owner         owner?     @relation(fields: [id_owner], references: [id_owner], onDelete: Restrict, onUpdate: Cascade, map: "fk_akun_owner")
  kasir         kasir?     @relation(fields: [id_kasir], references: [id_kasir], onDelete: Restrict, onUpdate: Cascade, map: "fk_akun_kasir")
  kapster       kapster?   @relation(fields: [id_kapster], references: [id_kapster], onDelete: Restrict, onUpdate: Cascade, map: "fk_akun_kapster")
  pelanggan     pelanggan? @relation(fields: [id_pelanggan], references: [id_pelanggan], onDelete: Restrict, onUpdate: Cascade, map: "fk_akun_pelanggan")
}
