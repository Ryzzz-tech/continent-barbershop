# Database PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/continent_db?schema=public"

# Secret JWT minimal 32 byte
SESSION_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES"

# Password akun untuk development seed
DEV_SEED_OWNER_PASSWORD="CHANGE_ME_OWNER"
DEV_SEED_KASIR_PASSWORD="CHANGE_ME_KASIR"
DEV_SEED_KAPSTER_PASSWORD="CHANGE_ME_KAPSTER"
DEV_SEED_PELANGGAN_PASSWORD="CHANGE_ME_PELANGGAN"